# Copy to `.env` and fill in values. Never commit real secrets.

# Build-time public (Vite client bundle — required for `bun run build` and Docker image build)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Runtime server (Cloud Run / Node — not available to the browser bundle after build)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=http://localhost:8080

# Development-only auth bypass for local UI inspection.
# Requires `bun run dev` (development mode). Ignored in production builds.
DEV_AUTH_BYPASS=false

# Gemini worker (real-project mode)
GEMINI_API_KEY=

# Google ADK mode flag (uses BuildLoop ADK-compatible shell + Gemini)
GOOGLE_ADK_ENABLED=0

# Persistence: local (default) or firestore
BUILDLOOP_PERSISTENCE=local
FIRESTORE_PROJECT_ID=
FIRESTORE_SERVICE_ACCOUNT_JSON=
BUILDLOOP_FIRESTORE_EMULATOR=0
